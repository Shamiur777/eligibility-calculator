# Copy this file to .env and fill in real values before running in production.
# Never commit the actual .env file to GitHub.

# Port the API listens on
PORT=4000

# Comma-separated list of domains allowed to submit leads (CORS).
# Must exactly match the origin the calculator is hosted on, including
# https:// and no trailing slash.
ALLOWED_ORIGINS=https://edgecoursebd.com,https://www.edgecoursebd.com

# REQUIRED to view/export leads. At least 16 characters. If it is missing,
# too short, or left as the placeholder below, the export endpoints refuse
# every request (HTTP 503) so student data is never exposed by accident.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-this-to-a-long-random-string

# Set when the API runs behind a reverse proxy (nginx, Render, Railway,
# Cloudflare...). Number of proxy hops, usually 1. Leave empty when the API
# is reached directly - otherwise clients could fake their IP address.
TRUST_PROXY=

# Optional: where the SQLite file lives (default: ./data/leads.db).
# On Render/Railway/Fly point this at the persistent volume.
DB_PATH=
